<UserControl x:Class="ControlesAccesoQR.Views.Shared.FingerprintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="200" Width="300">
    <Border Background="#AA000000" CornerRadius="8" Padding="20">
        <StackPanel>
            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Width="80" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
